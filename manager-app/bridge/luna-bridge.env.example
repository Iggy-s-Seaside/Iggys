# Luna <-> Iggy's bridge environment.
# Deploy as /home/bradley/.local-agent/luna-iggys-bridge.env  (chmod 600).
# Placeholders only - NEVER commit real secrets.

# Direct Postgres DSN for the least-privilege 'luna_bridge' role, via the
# Supavisor SESSION pooler (port 5432). Format:
#   postgresql://<role>.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
LUNA_BRIDGE_DSN=postgresql://luna_bridge.nouxyrqpulkbjusriugx:CHANGEME@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Luna's local chat API (SSE).
LUNA_API_URL=http://localhost:3033/api/chat

# Bearer token for Luna's API. On PC1 it already exists - copy it from:
#   grep LUNA_API_TOKEN ~/.local-agent/luna-api.env
LUNA_API_TOKEN=CHANGEME

# How often the daemon polls luna_messages for pending questions.
LUNA_POLL_SECONDS=5
